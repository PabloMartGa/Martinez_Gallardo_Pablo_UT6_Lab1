<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla de mando, en vertical y de arriba abajo:
      1) Spinner  -> elegir el canal (cabecera)
      2) PlayerView -> el vídeo, ocupando todo el hueco que sobre en medio
      3) TextView -> el estado de la conexión (zona inferior)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Cabecera: selector desplegable de canales -->
    <Spinner
        android:id="@+id/spinnerCanales"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:contentDescription="@string/titulo_selector" />

    <!-- Zona central: aquí se pinta el vídeo -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:background="@color/white"
        app:resize_mode="fit"
        app:show_buffering="never" />

    <!-- Zona inferior: texto de estado que cambia según lo que diga el reproductor -->
    <TextView
        android:id="@+id/textoEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/estado_inicial"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>